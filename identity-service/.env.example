# Identity Service Environment Configuration
# Copy this file to .env and fill in your values

# Database (for Docker profile)
IDENTITY_DB_HOST=localhost
IDENTITY_DB_PORT=5432
IDENTITY_DB_NAME=identity_db
IDENTITY_DB_USER=identity
IDENTITY_DB_PASSWORD=local_identity_dev

# JWT Secret (must be at least 32 characters for HS256)
JWT_SECRET=your-super-secret-jwt-key-at-least-32-chars-long

# SMS Provider Configuration
# Options: "log" (development - prints OTP to console), "twilio" (production)
SMS_PROVIDER=log

# Twilio SMS Configuration (required when SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+15551234567

# Email Provider Configuration
# Options: "log" (development - prints OTP to console), "smtp" (production)
EMAIL_PROVIDER=log

# SMTP Email Configuration (required when EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@yourdomain.com

# Admin credentials (for Spring Security admin endpoints)
ADMIN_PASSWORD=admin