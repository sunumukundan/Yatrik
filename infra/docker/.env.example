# Copy to .env and fill in. Never commit the filled-in .env.
#
# The four database passwords are only used by docker-compose to initialise the local
# Postgres containers. The services read the same values from the environment when
# they start (IDENTITY_DB_PASSWORD, FLEET_DB_PASSWORD, ...).

# --- Database passwords (required; docker-compose refuses to start without them) ---
IDENTITY_DB_PASSWORD=
FLEET_DB_PASSWORD=
TRIP_DB_PASSWORD=
LEDGER_DB_PASSWORD=

# --- Optional overrides; the defaults match the service application.yml files ---
IDENTITY_DB_NAME=identity_db
IDENTITY_DB_USER=identity
IDENTITY_DB_PORT=5432

FLEET_DB_NAME=fleet_db
FLEET_DB_USER=fleet
FLEET_DB_PORT=5433

TRIP_DB_NAME=trip_db
TRIP_DB_USER=trip
TRIP_DB_PORT=5434

LEDGER_DB_NAME=ledger_db
LEDGER_DB_USER=ledger
LEDGER_DB_PORT=5435
